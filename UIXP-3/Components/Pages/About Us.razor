@page "/aboutus"

<title>About Us</title>

<link href="css/UI-pack.css" rel="stylesheet">

<style>
    body {
        background-color: white;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        margin: 0;
        padding: 0;
    }

    .about-container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 40px 20px;
    }

    .about-hero {
        text-align: center;
        margin-bottom: 50px;
        background: linear-gradient(to bottom, #007BFF, #4CC9F0);
        padding: 40px 20px;
        border-radius: 12px;
    }

    .about-title {
        font-size: 3rem;
        margin-bottom: 10px;
        color: white;
    }

    .about-subtitle {
        font-size: 1.5rem;
        color: white;
    }

    .about-section {
        margin-bottom: 40px;
    }

        .about-section h2 {
            color: #333;
            font-size: 2rem;
            margin-bottom: 15px;
        }

        .about-section p {
            font-size: 1.1rem;
            color: #666;
            line-height: 1.6;
        }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-top: 30px;
    }

    .feature-card {
        background-color: #f9f9f9;
        padding: 20px;
        border-radius: 12px;
        border: none; /* no border */
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3); /* darker and stronger shadow */
        text-align: center;
    }

        .feature-card i {
            font-size: 2.5rem;
            color: #4CC9F0;
            margin-bottom: 10px;
        }

        .feature-card h3 {
            font-size: 1.5rem;
            margin-bottom: 10px;
            color: #333;
        }

        .feature-card p {
            color: #665;
            font-size: 1rem;
        }

    .back-home {
        margin-top: 50px;
        text-align: center;
    }

    .home-link {
        font-size: 1.2rem;
        color: #4CC9F0;
        text-decoration: none;
        font-weight: bold;
    }

    /*        .home-link:hover {
                text-decoration: underline;
            } */
</style>

<div class="about-container">
    <div class="about-hero">
        <h1 class="about-title">About My Platform</h1>
        <p class="about-subtitle">Empowering education through innovative technology</p>
    </div>

    <div class="about-content">
        <section class="about-section">
            <h2><i class="fas fa-rocket"></i> My Mission</h2>
            <p>I am interested in transforming how educators and students interact by providing real-time progress tracking, streamlined communication tools, and actionable insights to enhance the learning experience.</p>
        </section>

        <section class="about-section">
            <h2><i class="fas fa-history"></i> My Story</h2>
            <p>Founded in 2024, I aspired to take my software further into more User Interactive for better student progress tracking tools. What began as a classroom solution has grown into a comprehensive platform.</p>
        </section>

        <div class="features-grid">
            <div class="feature-card">
                <i class="fas fa-chart-line"></i>
                <h3>Real-Time Analytics</h3>
                <p>Instant access to student performance metrics and trends.</p>
            </div>
            <div class="feature-card">
                <i class="fas fa-calendar-check"></i>
                <h3>Scheduling Tools</h3>
                <p>Easily coordinate meetings and deadlines.</p>
            </div>
            <div class="feature-card">
                <i class="fas fa-layer-group"></i>
                <h3>Progress Tracking</h3>
                <p>Visualize student development over time with detailed reports.</p>
            </div>
        </div>

        <div class="back-home">
            <a href="/" class="home-link"> Back to Home</a>
        </div>
    </div>
</div>

