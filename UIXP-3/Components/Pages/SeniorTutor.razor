@page "/seniortutordashboard"

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Senior Tutor Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        /* EXACTLY THE SAME STYLES AS STUDENT DASHBOARD */
        :root {
            --primary: #4361ee;
            --secondary: #3f37c9;
            --light: #f8f9fa;
            --dark: #212529;
            --success: #4cc9f0;
            --danger: #f72585;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f5f7fa;
            color: var(--dark);
            margin: 0;
            padding: 0;
        }

        .dashboard-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
        }

        .dashboard-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .card {
            background: white;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
            padding: 2rem;
            margin-bottom: 2rem;
        }

        .dashboard-nav {
            display: flex;
            justify-content: space-between;
            margin-bottom: 2rem;
        }

        .nav-link {
            color: var(--primary);
            text-decoration: none;
            font-weight: 500;
        }

        /* NEW COMMUNICATION STYLES */
        .communication-list {
            margin-top: 1.5rem;
        }

        .communication-item {
            padding: 1.5rem;
            border-bottom: 1px solid #eee;
            transition: all 0.3s ease;
        }

            .communication-item:hover {
                background-color: rgba(67, 97, 238, 0.05);
            }

        .communication-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 0.5rem;
        }

        .sender {
            font-weight: 600;
            color: var(--primary);
        }

        .recipient {
            font-weight: 500;
            color: var(--secondary);
        }

        .timestamp {
            color: #6c757d;
            font-size: 0.875rem;
        }

        .message-content {
            margin-top: 0.75rem;
            line-height: 1.6;
        }

        .report-tag {
            display: inline-block;
            background-color: rgba(76, 201, 240, 0.2);
            color: #0a9396;
            padding: 0.25rem 0.5rem;
            border-radius: 4px;
            font-size: 0.75rem;
            margin-left: 0.5rem;
        }

        .meeting-tag {
            display: inline-block;
            background-color: rgba(67, 97, 238, 0.2);
            color: var(--primary);
            padding: 0.25rem 0.5rem;
            border-radius: 4px;
            font-size: 0.75rem;
            margin-left: 0.5rem;
        }
    </style>
</head>
<body>
    <div class="dashboard-container">
        <div class="dashboard-nav">
            <a href="/SeniorTutorlogin" class="nav-link">← Logout </a>
            <h1>Senior Tutor Dashboard</h1>
            <div></div>
        </div>

        <!-- Communication Overview Card -->
        <div class="card">
            <h2>Student-Supervisor Communications</h2>
            <div class="communication-list">
                <!-- Sample Report Submission -->
                <div class="communication-item">
                    <div class="communication-header">
                        <div>
                            <span class="sender">John Doe (Student)</span> →
                            <span class="recipient">Dr. Smith (Supervisor)</span>
                            <span class="report-tag">Report</span>
                        </div>
                        <div class="timestamp">2023-06-15, Time: 14:30</div>
                    </div>
                    <div class="message-content">
                        <strong>Progress Report:</strong> Completed all module assignments with distinction. Requesting feedback on final project proposal attached.
                    </div>
                </div>

                <!-- Sample Meeting Booking -->
                <div class="communication-item">
                    <div class="communication-header">
                        <div>
                            <span class="sender">Dr. Smith (Supervisor)</span> →
                            <span class="recipient">John Doe (Student)</span>
                            <span class="meeting-tag">Meeting</span>
                        </div>
                        <div class="timestamp">2023-06-16, Time: 09:15</div>
                    </div>
                    <div class="message-content">
                        <strong>Scheduled Meeting:</strong> Approved project proposal. Let's discuss research methodology on June 20th at 2:00 PM in my office.
                    </div>
                </div>

                <!-- Sample Report Submission -->
                <div class="communication-item">
                    <div class="communication-header">
                        <div>
                            <span class="sender">Jane Smith (Student)</span> →
                            <span class="recipient">Dr. Brown (Supervisor)</span>
                            <span class="report-tag">Report</span>
                        </div>
                        <div class="timestamp">2023-06-14, Time: 11:20</div>
                    </div>
                    <div class="message-content">
                        <strong>Weekly Update:</strong> Facing challenges with data collection for chapter 3. Requesting guidance on alternative methodologies.
                    </div>
                </div>

                <!-- Sample Meeting Booking -->
                <div class="communication-item">
                    <div class="communication-header">
                        <div>
                            <span class="sender">Dr. Brown (Supervisor)</span> →
                            <span class="recipient">Jane Smith (Student)</span>
                            <span class="meeting-tag">Meeting</span>
                        </div>
                        <div class="timestamp">2023-06-14, Time: 16:45</div>
                    </div>
                    <div class="message-content">
                        <strong>Meeting Scheduled:</strong> Let's address your methodology questions tomorrow at 10 AM in the research lab. Bring your current datasets.
                    </div>
                </div>
            </div>
        </div>

        <!-- Statistics Card -->
        <div class="card">
            <h2>Communication Overview</h2>
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;">
                <div style="background: rgba(76, 201, 240, 0.1); padding: 1.5rem; border-radius: 8px;">
                    <h3 style="margin-top: 0; color: var(--primary);">24</h3>
                    <p style="margin-bottom: 0; color: var(--dark);">Reports Submitted</p>
                </div>
                <div style="background: rgba(67, 97, 238, 0.1); padding: 1.5rem; border-radius: 8px;">
                    <h3 style="margin-top: 0; color: var(--primary);">18</h3>
                    <p style="margin-bottom: 0; color: var(--dark);">Meetings Booked</p>
                </div>
                <div style="background: rgba(76, 201, 240, 0.1); padding: 1.5rem; border-radius: 8px;">
                    <h3 style="margin-top: 0; color: var(--primary);">5</h3>
                    <p style="margin-bottom: 0; color: var(--dark);">Pending Actions</p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>