@page "/Supervisorlogin"
@inject NavigationManager Navigation

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Account</title>
    <style>
        :root {
            --primary: #4361ee;
            --secondary: #3a56d4;
            --light: #f8f9fa;
            --dark: #212529;
            --danger: #f72585;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f5f7ff;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            color: var(--dark);
        }

        .register-container {
            width: 100%;
            max-width: 420px;
            padding: 2rem;
        }

        .register-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
            padding: 2.5rem;
        }

        .register-title {
            font-size: 1.75rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            color: var(--primary);
            text-align: center;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 500;
        }

        input {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            font-size: 1rem;
            box-sizing: border-box;
        }

        .register-btn {
            width: 100%;
            padding: 0.75rem;
            background-color: var(--primary);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            margin-top: 0.5rem;
        }

        .left-link {
            position: fixed;
            top: 1.5rem;
            left: 2rem;
            z-index: 1000;
        }

            .left-link a {
                text-decoration: none;
                color: var(--primary);
                font-weight: 600;
                font-size: 1rem;
            }

        .left-link {
            position: fixed;
            top: 1.5rem;
            left: 2rem;
            z-index: 1000;
        }

            .left-link a {
                text-decoration: none;
                color: var(--primary);
                font-weight: 600;
                font-size: 1rem;
            }

    </style>
</head>
<body>
    <div class="register-container">
        <div class="register-card">
            <h1 class="register-title">Login</h1>

            <div class="left-link">
                <a href="/">Previous Page</a>
            </div>

            <div class="form-group">
                <label>Email Address</label>
                <input type="email" placeholder="Enter your email" id="email">
            </div>

            <div class="form-group">
                <label>Password</label>
                <input type="password" placeholder="Enter your password" id="password">
            </div>

            <button class="register-btn" onclick="validateLogin()">Login</button>
            <br>
            <p style="text-align: center; margin-top: 1rem;">Dont't have an account? <a href="/SupervisorRegister" style="color: var(--primary);">Sign Up</a></p>

        </div>
    </div>

    <script>
        function validateLogin()
        {
            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;

            if (!email || !password)
            {
                alert('Fill in all the fields');
                return false;
            }

            window.location.href = 'supervisordashboard';
            return true;
        }
    </script>
</body>
</html>
