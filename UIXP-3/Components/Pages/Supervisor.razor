@page "/supervisordashboard"

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Supervisor Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #4361ee;
            --secondary: #3f37c9;
            --light: #f8f9fa;
            --dark: #212529;
            --success: #4cc9f0;
            --danger: #f72585;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f5f7fa;
            color: var(--dark);
            margin: 0;
            padding: 0;
        }

        .dashboard-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
        }

        .dashboard-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .card {
            background: white;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
            padding: 2rem;
            margin-bottom: 2rem;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 500;
        }

        input, textarea, select {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-family: inherit;
            font-size: 1rem;
        }

        textarea {
            min-height: 120px;
            resize: vertical;
        }

        .btn {
            display: inline-block;
            padding: 0.75rem 1.5rem;
            background-color: var(--primary);
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 1rem;
            font-weight: 500;
            transition: all 0.3s ease;
        }

            .btn:hover {
                background-color: var(--secondary);
                transform: translateY(-2px);
            }

        .confirmation {
            padding: 1rem;
            border-radius: 5px;
            margin-top: 1rem;
        }

        .success {
            background-color: rgba(76, 201, 240, 0.2);
            color: #0a9396;
        }

        .info {
            background-color: rgba(64, 123, 255, 0.2);
            color: var(--primary);
        }

        .dashboard-nav {
            display: flex;
            justify-content: space-between;
            margin-bottom: 2rem;
        }

        .nav-link {
            color: var(--primary);
            text-decoration: none;
            font-weight: 500;
        }

        .report-list {
            margin-top: 1.5rem;
        }

        .report-item {
            padding: 1rem;
            border-bottom: 1px solid #eee;
            display: flex;
            justify-content: space-between;
        }

            .report-item:last-child {
                border-bottom: none;
            }

        .student-select {
            margin-bottom: 1.5rem;
        }

        .other-student-input {
            margin-top: 1rem;
            display: none;
            animation: fadeIn 0.3s ease;
        }

        .show-other-input {
            display: block;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<body>
    <div class="dashboard-container">
        <div class="dashboard-nav">
            <a href="/Supervisorlogin" class="nav-link">← Logout </a>
            <h1>Supervisor Dashboard</h1>
            <div></div>
        </div>

        <!-- Student Reports -->
        <div class="card">
            <h2>Student Reports</h2>
            <div class="report-list">
                <div class="report-item">
                    <div>
                        <strong>Jahidul Alam</strong>
                        <p>Completed all module assignments with excellent results.</p>
                    </div>
                    <small>Submitted: 2023-06-18</small>
                </div>
                <div class="report-item">
                    <div>
                        <strong>Rakibul Islam</strong>
                        <p>Requesting guidance on final project research methodology.</p>
                    </div>
                    <small>Submitted: 2023-06-17</small>
                </div>
            </div>
        </div>

        <!-- Meeting Booking -->
        <div class="card">
            <h2>Schedule Meeting</h2>
            <div class="form-group student-select">
                <label for="student">Select Student</label>
                <select id="student" onchange="toggleOtherStudent()">
                    <option value="">-- Choose student --</option>
                    <option value="jahidul">Jahidul Alam</option>
                    <option value="rakibul">Rakibul Islam</option>
                    <option value="shumon">Shumon</option>
                    <option value="other">Other Student...</option>
                </select>
            </div>

            <div id="otherStudentContainer" class="form-group other-student-input">
                <label for="other-student">Enter Student Name</label>
                <input type="text" id="other-student" placeholder="Firstname Lastname">
            </div>

            <div class="form-group">
                <label for="meeting-topic">Meeting Topic</label>
                <input type="text" id="meeting-topic" placeholder="Enter the meeting topic....">
            </div>

            <div class="form-group">
                <label for="meeting-date">Meeting Date</label>
                <input type="date" id="meeting-date">
            </div>

            <button class="btn" onclick="handleBooking()">Schedule Meeting</button>

            <div id="confirmation" class="confirmation success" style="display: none;">
                Meeting scheduled successfully
            </div>
        </div>
    </div>

    <script>
        // Toggle other student input
        function toggleOtherStudent() {
            const select = document.getElementById('student');
            const otherInput = document.getElementById('otherStudentContainer');

            if (select.value === 'other') {
                otherInput.classList.add('show-other-input');
            } else {
                otherInput.classList.remove('show-other-input');
            }
        }

        // Handle meeting booking
        function handleBooking() {
            const select = document.getElementById('student');
            const otherName = document.getElementById('other-student').value.trim();
            const topic = document.getElementById('meeting-topic').value.trim();
            const date = document.getElementById('meeting-date').value;
            const confirmation = document.getElementById('confirmation');

            // Validate inputs
            if (!select.value) {
                alert('Select a student or choose "Other Student"');
                return;
            }

            if (select.value === 'other' && !otherName) {
                alert('Enter the student name');
                return;
            }

            if (!topic) {
                alert('Enter a meeting topic');
                return;
            }

            if (!date) {
                alert('Select a meeting date');
                return;
            }

            // Get student name
            const studentName = select.value === 'other'
                ? otherName
                : select.options[select.selectedIndex].text;

            // Show confirmation
            confirmation.innerHTML = `
                Scheduled meeting with: <strong>${studentName}</strong><br>
                Topic: <strong>${topic}</strong><br>
                Date: <strong>${new Date(date).toDateString()}</strong>
            `;
            confirmation.style.display = 'block';

            // Reset form after 5 seconds
            setTimeout(() => {
                select.value = '';
                document.getElementById('other-student').value = '';
                document.getElementById('meeting-topic').value = '';
                document.getElementById('meeting-date').value = '';
                document.getElementById('otherStudentContainer').classList.remove('show-other-input');
                confirmation.style.display = 'none';
            }, 5000);
        }
    </script>
</body>
</html>