    <div class="offcanvas offcanvas-end" data-bs-scroll="true" tabindex="-1" id="offcanvasMenu" aria-labelledby="offcanvasMenuLabel">
        <div class="offcanvas-header">
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column justify-content-center align-items-center">
            <nav>
                <ul>
                    <li>
                        <a href="/NQ">Frequently Asked Questions</a>
                    </li>
                    
                    <li>
                        <br>
                        <a href="/aboutus">About Us</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>

    <section class="hero-section hero-bg d-flex justify-content-center align-items-center">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 col-12 text-center mx-auto">
                    <br><br><br>
                    <p class="page-home-description">Choose your position from the drop-down box</p>
                    <br><br>
                    <section class="options-section d-flex justify-content-center align-items-center">
                        <div class="options-box">
                            <ul>
                                <li>
                                    <a href="/Studentlogin"><b>Student</b></a>
                                </li>
                                <li>
                                    <a href="/Supervisorlogin"><b>Supervisor</b></a>
                                </li>
                                <li>
                                    <a href="/SeniorTutorlogin"><b>Senior Tutor</b></a>
                                </li>
                            </ul>
                        </div>
                    </section>
                </div>
            </div>
